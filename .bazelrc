common:ci --lockfile_mode=error

build:release -c opt
build:release --@rules_rust//rust/settings:lto=fat

build:remote_cache --remote_cache=grpc://localhost:8980

build:remote_exec --remote_executor=grpc://localhost:8980
build:remote_exec --remote_instance_name=homelab
build:remote_exec --remote_default_exec_properties=ISA=aarch64
build:remote_exec --remote_default_exec_properties=OSFamily=linux
build:remote_exec --remote_default_exec_properties=pool=ubuntu24-04-v2
build:remote_exec --platforms=//:remote_linux_arm64
build:remote_exec --extra_execution_platforms=//:remote_linux_arm64
build:remote_exec --extra_toolchains=@llvm//toolchain:linux_aarch64_to_linux_aarch64
build:remote_exec --symlink_prefix=bazel-linux-
